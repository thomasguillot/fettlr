---
import Mark from "./Mark.astro";
import { AUTHOR_NAME, AUTHOR_URL, LICENSE_URL, REPO_URL, year } from "../site";

const links = [
  { label: "GitHub", href: REPO_URL },
  { label: "License", href: LICENSE_URL },
  { label: "Releases", href: `${REPO_URL}/releases` },
  { label: "Report an issue", href: `${REPO_URL}/issues` },
];
---

<footer>
  <div
    class="n-shell flex flex-col items-start justify-between gap-6 pb-12 sm:flex-row sm:items-center"
  >
    <div class="flex items-center gap-2.5">
      <Mark size={24} />
      <p class="text-sm text-text-muted">
        Fettlr &middot; &copy; {year} <a
          href={AUTHOR_URL}
          class="n-link text-sm text-accent-text"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${AUTHOR_NAME}, opens in a new tab`}
          >{AUTHOR_NAME}<span aria-hidden="true">&nearr;</span></a
        >
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2">
      {
        links.map((link) => (
          <a href={link.href} class="n-link text-sm text-accent-text">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
